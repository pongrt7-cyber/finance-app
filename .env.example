PORT=3000
JWT_SECRET=changeme_generate_random_string
ADMIN_PASSWORD=changeme
ANTHROPIC_API_KEY=your_key_here
DB_PATH=./server/db/finance.db

# Turso Cloud database (production)
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=your_database_token

# Gmail Push / Pub/Sub
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/finance-gmail
GMAIL_PUBSUB_AUDIENCE=https://YOUR_PUBLIC_WEBHOOK/
GMAIL_PUBSUB_SERVICE_ACCOUNT=cloud-run-pubsub-invoker@YOUR_PROJECT_ID.iam.gserviceaccount.com
