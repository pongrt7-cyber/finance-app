PORT=3000
JWT_SECRET=changeme_generate_random_string
ADMIN_PASSWORD=changeme
ANTHROPIC_API_KEY=your_key_here
DB_PATH=./server/db/finance.db

# Gmail Push / Pub/Sub (set after creating the Google Cloud topic/subscription)
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/finance-gmail
GMAIL_PUBSUB_AUDIENCE=https://YOUR_TAILSCALE_HOST.ts.net/api/gmail/pubsub
GMAIL_PUBSUB_SERVICE_ACCOUNT=cloud-run-pubsub-invoker@YOUR_PROJECT_ID.iam.gserviceaccount.com
